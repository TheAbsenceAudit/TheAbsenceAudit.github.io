# never let source material or secrets into the public repo
.env
*.key
*_report.md
*_economics.*
*_validation.*
*_audit.md
*.orig
__pycache__/
PUBLISH_STATUS.md
_tmp_idx.html
# foreign build artifacts dumped into the site root (2026-09-07
# incident: ~65 webpack chunk_*.js + config.js appeared untracked
# and hard-blocked the apolitical gate) — never commit these
/chunk_*.js
/config.js
# i18n pipeline junk (nested _fr_aside snapshots, path-length hazards) — never commit
_fr_aside*/
# SECURITY (2026-09-11): translated PAID dossier subpages + private audio never ship
fr/dossier/*/
zh/dossier/*/
ru/dossier/*/
nations/**/*.mp3
nations/*.pdf
_*_aside*/
# i18n withheld/retired pages (purity gate fail-closed archive) — never commit
_i18n_orphans/
# local desktop attachments (user uploads) never ship
.hermes/
# SECURITY (owner 2026-09-07 AM + PM): static hosting cannot gate —
# paid bytes never enter the public repo. Full dossiers (subfolders of
# /dossier/; the member-ledger index stays public), gated audio, and
# report PDFs stay local-only / email-delivered. NOTE: this template is
# the canonical .gitignore — hand-edits to the generated repo's copy are
# overwritten by every publish, so security entries MUST live here.
/dossier/*/
/subscriber/audio/
# full autopsy audio (breach #3 class, 2026-09-08): the FULL mp3 of
# anything that sells reads the gated report aloud — private in
# _nlm/audio; only the 60s public teasers ship. Negation keeps them.
/audio/*.mp3
!audio/teaser-*.mp3
c/**/*.pdf
case-study/*.pdf
track-record/*.pdf
pdf_render_report.json
# oversized source media (2026-09-11 incident: two unreferenced
# 137/147 MB films in nations/ were swept into a publish commit by
# `git add nations` — TRACKED carries DIRECTORIES — and GitHub then
# rejected EVERY push with GH001 >100 MB. site_publish.py also
# hard-skips any TRACKED blob over 95 MB; these rules keep the
# known offenders out of the index at source. FIX HERE, never in the
# generated repo copy (see the note above).
nations/closed-loop-*.mp4
